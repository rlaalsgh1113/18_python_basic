    "# 중첩 루프 사용하기\n",
    "\n",
    "for i in range(5) : # 바깥 루프는 세로\n",
    "    for j in range(5) : # 안 루프는 가로\n",
    "        print(\"J:\", j, sep=\"\",end=\" \")\n",
    "    print(\"i:\", i, \"\\\\n\", sep=\"\")"
